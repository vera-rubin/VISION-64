{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-64.invalid/schemas/rook-link/request-v1.schema.json",
  "title": "ROOK LINK request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "repository", "base_commit", "operation", "scope", "probe", "acknowledgement"],
  "properties": {
    "schema": {"const": "rook-link.request.v1"},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "operation": {"const": "probe.environment.v1"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allow_mutation", "delegate"],
      "properties": {
        "mode": {"const": "read-only"},
        "allow_mutation": {"const": false},
        "delegate": {"const": false}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "tools"],
      "properties": {
        "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["hostname", "date_utc", "tool_versions"]}},
        "tools": {"type": "array", "uniqueItems": true, "items": {"enum": ["git", "rustc", "cargo", "qemu-system-x86_64", "python3"]}}
      }
    },
    "acknowledgement": {"type": "string", "pattern": "^rook-link:[a-z0-9][a-z0-9._-]{0,63}:probe\\.environment\\.v1:read-only$"}
  }
}
