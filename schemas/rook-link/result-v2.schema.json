{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vision-64.invalid/schemas/rook-link/result-v2.schema.json",
  "title": "ROOK LINK result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "repository", "request_commit", "request_path", "base_commit", "operation", "status", "started_at", "finished_at", "capabilities_used", "summary", "actions", "artifacts", "git", "delegation"],
  "properties": {
    "schema": {"const": "rook-link.result.v2"},
    "request_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "request_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "request_path": {"type": "string", "pattern": "^ops/rook/requests/[A-Za-z0-9._/-]+$"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "operation": {"const": "orchestrate.task.v1"},
    "status": {"enum": ["pass", "fail", "blocked", "partial"]},
    "started_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "finished_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "capabilities_used": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "repo.read",
          "repo.task-write",
          "git.task-branch",
          "process.user",
          "tmux.manage",
          "runner.inspect",
          "runner.execute",
          "runner.manage",
          "qemu.execute",
          "artifact.collect",
          "tooling.install",
          "network.outbound",
          "worker.delegate",
          "github.issue.write",
          "github.pr.write",
          "computer.read",
          "computer.task-write"
        ]
      }
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "actions": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "description", "outcome", "evidence"],
        "properties": {
          "capability": {
            "enum": [
              "repo.read",
              "repo.task-write",
              "git.task-branch",
              "process.user",
              "tmux.manage",
              "runner.inspect",
              "runner.execute",
              "runner.manage",
              "qemu.execute",
              "artifact.collect",
              "tooling.install",
              "network.outbound",
              "worker.delegate",
              "github.issue.write",
              "github.pr.write",
              "computer.read",
              "computer.task-write"
            ]
          },
          "description": {"type": "string", "minLength": 1, "maxLength": 1000},
          "outcome": {"enum": ["pass", "fail", "blocked", "partial"]},
          "evidence": {
            "type": "array",
            "maxItems": 16,
            "items": {"type": "string", "maxLength": 8000}
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "locator", "sha256", "description"],
        "properties": {
          "kind": {"enum": ["log", "report", "diff", "benchmark", "test-output", "archive", "other"]},
          "locator": {"type": "string", "minLength": 1, "maxLength": 1024},
          "sha256": {
            "anyOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            ]
          },
          "description": {"type": "string", "maxLength": 1000}
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "head_commit", "dirty"],
      "properties": {
        "branch": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 128}
          ]
        },
        "head_commit": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}
          ]
        },
        "dirty": {"type": "boolean"}
      }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["used", "workers"],
      "properties": {
        "used": {"type": "boolean"},
        "workers": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "task", "status"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 64},
              "task": {"type": "string", "minLength": 1, "maxLength": 1000},
              "status": {"enum": ["pass", "fail", "blocked", "partial"]}
            }
          }
        }
      }
    }
  }
}
